# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=nextkraft
DB_PORT=3306

# SSL Configuration (Optional)
DB_SSL_ENABLED=false
DB_SSL_CA=./ca.pem
DB_SSL_REJECT_UNAUTHORIZED=true

# Database Sync (set to 'true' to sync on startup - use with caution!)
SYNC_DB=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Firebase Cloud Messaging (Admin SDK) — same Firebase project as the apps
# Prefer a file path (service_account.json is gitignored). Use KEY only if you
# cannot mount a file (e.g. some PaaS). Set one of the two, not both.
FCM_SERVICE_ACCOUNT_PATH=./service_account.json
# FCM_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# SMTP / Email (forgot-password OTP). If SMTP_HOST is empty, OTP is logged to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NextKraft <noreply@nextkraft.com>
EMAIL_LOG_OTP=true
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
